{
  "name": "tron-allowance-spending-dapp",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "tsx backend/src/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "contract:test": "node scripts/validate-tron-env.js test && tronbox test --network development",
    "contract:compile": "tronbox compile",
    "deploy:shasta": "node scripts/validate-tron-env.js deploy && tronbox migrate --network shasta"
  },
  "dependencies": {
    "@tronweb3/tronwallet-adapter-tronlink": "^1.1.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tronweb": "^6.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^9.0.1",
    "solhint": "^5.0.5",
    "tronbox": "^3.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
